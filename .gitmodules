[submodule ".registry"]
	path = .registry
	url = https://github.com/rootcoder007/rootcoder007.r-universe.dev
	branch = HEAD
[submodule "crimlab"]
	path = crimlab
	url = https://github.com/rootcoder007/crimlab
	branch = main
[submodule "noqtis"]
	path = noqtis
	url = https://github.com/rootcoder007/noqtis
	branch = main
	subdir = bindings/r
[submodule "rmorie"]
	path = rmorie
	url = https://github.com/rootcoder007/rmorie
	branch = main
[submodule "rmoriebricklayer"]
	path = rmoriebricklayer
	url = https://github.com/rootcoder007/rmorie-bricklayer
	branch = main
[submodule "rmoriedata"]
	path = rmoriedata
	url = https://github.com/rootcoder007/rmoriedata
	branch = main
